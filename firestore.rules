rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Security Primitives
    // ---------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function requesterEmail() {
      return request.auth.token.email.lower();
    }

    function emailKeyFor(emailStr) {
      return emailStr.lower()
        .replace('@', '_at_')
        .replace('\\.', '_dot_')
        .replace('[^a-z0-9_-]', '_');
    }

    function requesterEmailKey() {
      return emailKeyFor(request.auth.token.email);
    }

    function isPrimaryOwner() {
      return isVerifiedUser() && requesterEmail() == 'naseebsaleemvmi@gmail.com';
    }

    function portalUserPath() {
      return /databases/$(database)/documents/portalUsers/$(requesterEmailKey());
    }

    function isActiveUserDoc(u) {
      return u is map &&
        u.active == true &&
        u.email == requesterEmail() &&
        u.permissions is map;
    }

    function userIsPortalAdmin(u) {
      return isActiveUserDoc(u) && u.role == 'Admin' && u.permissions.usersManage == true;
    }

    function userCanWriteInventory(u) {
      return isActiveUserDoc(u) && u.permissions.inventoryWrite == true;
    }

    function userCanDeleteInventory(u) {
      return isActiveUserDoc(u) && u.permissions.inventoryDelete == true;
    }

    function userCanReadBookings(u) {
      return isActiveUserDoc(u) && u.permissions.bookingsRead == true;
    }

    function userCanWriteBookings(u) {
      return isActiveUserDoc(u) && u.permissions.bookingsWrite == true;
    }

    function userCanDeleteBookings(u) {
      return isActiveUserDoc(u) && u.permissions.bookingsDelete == true;
    }

    function userCanManageVideos(u) {
      return isActiveUserDoc(u) && u.permissions.videosManage == true;
    }

    function userCanManageUsers(u) {
      return isActiveUserDoc(u) && u.permissions.usersManage == true;
    }

    function isPortalAdmin() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userIsPortalAdmin(get(portalUserPath()).data)
      );
    }

    function canWriteInventory() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanWriteInventory(get(portalUserPath()).data)
      );
    }

    function canDeleteInventory() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanDeleteInventory(get(portalUserPath()).data)
      );
    }

    function canReadBookings() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanReadBookings(get(portalUserPath()).data)
      );
    }

    function canWriteBookings() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanWriteBookings(get(portalUserPath()).data)
      );
    }

    function canDeleteBookings() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanDeleteBookings(get(portalUserPath()).data)
      );
    }

    function canManageVideos() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanManageVideos(get(portalUserPath()).data)
      );
    }

    function canManageUsers() {
      return isPrimaryOwner() || (
        isVerifiedUser() &&
        exists(portalUserPath()) &&
        userCanManageUsers(get(portalUserPath()).data)
      );
    }

    // ---------------------------------------------------------
    // Validation Blueprints
    // ---------------------------------------------------------
    function isValidPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll([
          'inventoryRead',
          'inventoryWrite',
          'inventoryDelete',
          'bookingsRead',
          'bookingsWrite',
          'bookingsDelete',
          'videosManage',
          'usersManage'
        ]) &&
        perms.keys().hasOnly([
          'inventoryRead',
          'inventoryWrite',
          'inventoryDelete',
          'bookingsRead',
          'bookingsWrite',
          'bookingsDelete',
          'videosManage',
          'usersManage'
        ]) &&
        perms.inventoryRead is bool &&
        perms.inventoryWrite is bool &&
        perms.inventoryDelete is bool &&
        perms.bookingsRead is bool &&
        perms.bookingsWrite is bool &&
        perms.bookingsDelete is bool &&
        perms.videosManage is bool &&
        perms.usersManage is bool;
    }

    function isValidPortalUser(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'role',
          'active',
          'permissions',
          'isPrimaryOwner',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'email',
          'role',
          'active',
          'permissions',
          'isPrimaryOwner',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isNonEmptyStr(data.name, 120) &&
        isNonEmptyStr(data.email, 160) &&
        data.email == data.email.lower() &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.id == emailKeyFor(data.email) &&
        data.role in ['Admin', 'Editor', 'Viewer'] &&
        data.active is bool &&
        isValidPermissions(data.permissions) &&
        data.isPrimaryOwner is bool &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidVehicleTransit(transit) {
      return transit is map &&
        transit.keys().hasAll([
          'dealType',
          'destinationPortId',
          'destinationPortLabel',
          'vesselName',
          'arrivalStatus',
          'fullCifUsd',
          'priorDepositUsd',
          'balanceDueUsd',
          'blStatus'
        ]) &&
        transit.keys().hasOnly([
          'dealType',
          'destinationPortId',
          'destinationPortLabel',
          'vesselName',
          'arrivalStatus',
          'trackingStage',
          'etaDate',
          'fullCifUsd',
          'priorDepositUsd',
          'balanceDueUsd',
          'blStatus'
        ]) &&
        transit.dealType in ['direct-import', 'balance-release'] &&
        isNonEmptyStr(transit.destinationPortId, 80) &&
        isNonEmptyStr(transit.destinationPortLabel, 160) &&
        isNonEmptyStr(transit.vesselName, 160) &&
        isNonEmptyStr(transit.arrivalStatus, 200) &&
        (!('trackingStage' in transit) || transit.trackingStage in ['In Transit', 'At Port', 'Customs Clearing', 'Ready for Pickup']) &&
        (!('etaDate' in transit) || isBoundedStr(transit.etaDate, 32)) &&
        transit.fullCifUsd is number && transit.fullCifUsd >= 0 &&
        transit.priorDepositUsd is number && transit.priorDepositUsd >= 0 &&
        transit.balanceDueUsd is number && transit.balanceDueUsd >= 0 &&
        isNonEmptyStr(transit.blStatus, 240);
    }

    function isValidVehicleInspection(insp) {
      return insp is map &&
        insp.keys().hasAll([
          'auctionHouse',
          'lotNumber',
          'overallGrade',
          'exteriorGrade',
          'interiorGrade',
          'odometerVerified',
          'radiationCheck',
          'inspectorSummary',
          'bodyNotes'
        ]) &&
        insp.keys().hasOnly([
          'auctionHouse',
          'lotNumber',
          'overallGrade',
          'exteriorGrade',
          'interiorGrade',
          'odometerVerified',
          'radiationCheck',
          'inspectorSummary',
          'bodyNotes'
        ]) &&
        isNonEmptyStr(insp.auctionHouse, 120) &&
        isNonEmptyStr(insp.lotNumber, 40) &&
        isNonEmptyStr(insp.overallGrade, 20) &&
        isNonEmptyStr(insp.exteriorGrade, 20) &&
        isNonEmptyStr(insp.interiorGrade, 20) &&
        insp.odometerVerified is bool &&
        isNonEmptyStr(insp.radiationCheck, 80) &&
        isBoundedStr(insp.inspectorSummary, 1500) &&
        insp.bodyNotes is list &&
        insp.bodyNotes.size() <= 12 &&
        (insp.bodyNotes.size() == 0 || isNonEmptyStr(insp.bodyNotes[0], 300));
    }

    function isValidVehicle(data) {
      return data.keys().hasAll([
          'id',
          'makeModel',
          'trim',
          'category',
          'status',
          'year',
          'mileageKm',
          'chassisCode',
          'engine',
          'transmission',
          'drive',
          'fuel',
          'steering',
          'color',
          'port',
          'fobUsd',
          'image',
          'imageAlt',
          'createdAt',
          'transit',
          'inspection'
        ]) &&
        data.keys().hasOnly([
          'id',
          'makeModel',
          'trim',
          'category',
          'status',
          'year',
          'mileageKm',
          'chassisCode',
          'engine',
          'transmission',
          'drive',
          'fuel',
          'steering',
          'color',
          'port',
          'fobUsd',
          'cbm',
          'image',
          'images',
          'imageAlt',
          'createdAt',
          'updatedAt',
          'transit',
          'inspection'
        ]) &&
        isValidId(data.id) &&
        isNonEmptyStr(data.makeModel, 160) &&
        isNonEmptyStr(data.trim, 160) &&
        data.category in ['SUVs & 4x4', 'Hybrids', 'Sedans', 'Commercial'] &&
        data.status in ['Available', 'Booked', 'In Transit', 'Cleared'] &&
        data.year is int && data.year >= 1980 && data.year <= 2035 &&
        data.mileageKm is number && data.mileageKm >= 0 &&
        isNonEmptyStr(data.chassisCode, 64) &&
        isNonEmptyStr(data.engine, 120) &&
        isNonEmptyStr(data.transmission, 120) &&
        data.drive in ['4WD', '2WD', 'AWD'] &&
        data.fuel in ['Hybrid', 'Diesel', 'Petrol'] &&
        data.steering in ['RHD', 'LHD'] &&
        isNonEmptyStr(data.color, 80) &&
        isNonEmptyStr(data.port, 160) &&
        data.fobUsd is number && data.fobUsd >= 0 &&
        (!('cbm' in data) || (data.cbm is number && data.cbm > 0)) &&
        isNonEmptyStr(data.image, 350000) &&
        (!('images' in data) || (
          data.images is list &&
          data.images.size() >= 1 &&
          data.images.size() <= 8 &&
          isNonEmptyStr(data.images[0], 350000)
        )) &&
        isNonEmptyStr(data.imageAlt, 240) &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        isValidVehicleTransit(data.transit) &&
        isValidVehicleInspection(data.inspection);
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'id',
          'vehicleId',
          'vehicleTitle',
          'chassisCode',
          'buyerName',
          'buyerEmail',
          'buyerPhone',
          'destinationPortId',
          'destinationPortName',
          'requestType',
          'shippingMethod',
          'quotedAmountUsd',
          'notes',
          'status',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'vehicleId',
          'vehicleTitle',
          'chassisCode',
          'buyerName',
          'buyerEmail',
          'buyerPhone',
          'destinationPortId',
          'destinationPortName',
          'requestType',
          'shippingMethod',
          'quotedAmountUsd',
          'notes',
          'leadSource',
          'crmNotes',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        (data.vehicleId == null || isValidId(data.vehicleId)) &&
        isNonEmptyStr(data.vehicleTitle, 200) &&
        isNonEmptyStr(data.chassisCode, 64) &&
        isNonEmptyStr(data.buyerName, 120) &&
        isNonEmptyStr(data.buyerEmail, 160) &&
        data.buyerEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        isBoundedStr(data.buyerPhone, 48) &&
        isNonEmptyStr(data.destinationPortId, 80) &&
        isNonEmptyStr(data.destinationPortName, 160) &&
        data.requestType in [
          'Book Direct Japan Import',
          'Claim Port Balance Unit',
          'Custom Auction Order'
        ] &&
        data.shippingMethod in ['RoRo Vessel', '20ft Container', '40ft Shared Container'] &&
        data.quotedAmountUsd is number && data.quotedAmountUsd >= 0 &&
        isBoundedStr(data.notes, 2000) &&
        (!('leadSource' in data) || isBoundedStr(data.leadSource, 120)) &&
        (!('crmNotes' in data) || isBoundedStr(data.crmNotes, 3000)) &&
        data.status in [
          'Pending Review',
          'Contacted',
          'Deposit Confirmed',
          'Shipped / B/L Issued',
          'Cancelled'
        ] &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidVideo(data) {
      return data.keys().hasAll([
          'id',
          'title',
          'portLabel',
          'containerType',
          'vehicleSummary',
          'videoUrl',
          'posterUrl',
          'durationLabel',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'title',
          'portLabel',
          'containerType',
          'vehicleSummary',
          'videoUrl',
          'posterUrl',
          'durationLabel',
          'createdAt'
        ]) &&
        isValidId(data.id) &&
        isNonEmptyStr(data.title, 180) &&
        isNonEmptyStr(data.portLabel, 160) &&
        isNonEmptyStr(data.containerType, 120) &&
        isNonEmptyStr(data.vehicleSummary, 200) &&
        isNonEmptyStr(data.videoUrl, 750000) &&
        isNonEmptyStr(data.posterUrl, 350000) &&
        isNonEmptyStr(data.durationLabel, 32) &&
        data.createdAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------

    // Public catalog of Japanese export vehicles (contains zero PII)
    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId);
      allow list: if true;
      allow create: if isValidId(vehicleId) &&
        isValidVehicle(incoming()) &&
        incoming().id == vehicleId &&
        incoming().createdAt == request.time &&
        canWriteInventory();
      allow update: if isValidId(vehicleId) &&
        isValidVehicle(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        canWriteInventory() &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'makeModel',
            'trim',
            'category',
            'status',
            'year',
            'mileageKm',
            'chassisCode',
            'engine',
            'transmission',
            'drive',
            'fuel',
            'steering',
            'color',
            'port',
            'fobUsd',
            'cbm',
            'image',
            'images',
            'imageAlt',
            'updatedAt',
            'transit',
            'inspection'
          ]) ||
          isPortalAdmin()
        );
      allow delete: if isValidId(vehicleId) && canDeleteInventory();
    }

    // Buyer booking inquiries (strictly isolated PII: public create only, staff read/manage)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && canReadBookings();
      allow list: if canReadBookings();
      allow create: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == bookingId &&
        incoming().createdAt == request.time &&
        (
          (incoming().status == 'Pending Review' && (!('crmNotes' in incoming()) || incoming().crmNotes == '')) ||
          canWriteBookings()
        );
      allow update: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        canWriteBookings() &&
        (existing().status != 'Cancelled' || isPortalAdmin()) &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'crmNotes', 'updatedAt']) ||
          isPortalAdmin()
        );
      allow delete: if isValidId(bookingId) && canDeleteBookings();
    }

    // Public container unloading showcase videos (contains zero PII)
    match /videos/{videoId} {
      allow get: if isValidId(videoId);
      allow list: if true;
      allow create: if isValidId(videoId) &&
        isValidVideo(incoming()) &&
        incoming().id == videoId &&
        incoming().createdAt == request.time &&
        canManageVideos();
      allow update: if isValidId(videoId) &&
        isValidVideo(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'portLabel',
          'containerType',
          'vehicleSummary',
          'videoUrl',
          'posterUrl',
          'durationLabel'
        ]) &&
        canManageVideos();
      allow delete: if isValidId(videoId) && canManageVideos();
    }

    // Team Member RBAC directory (PII isolated to self or Admin)
    match /portalUsers/{userId} {
      allow get: if isValidId(userId) &&
        isVerifiedUser() &&
        (userId == requesterEmailKey() || canManageUsers());
      allow list: if canManageUsers();
      allow create: if isValidId(userId) &&
        isValidPortalUser(incoming()) &&
        incoming().id == userId &&
        incoming().createdAt == request.time &&
        (
          (
            isPrimaryOwner() &&
            userId == requesterEmailKey() &&
            incoming().email == requesterEmail() &&
            incoming().isPrimaryOwner == true &&
            incoming().role == 'Admin' &&
            incoming().active == true
          ) ||
          (
            incoming().isPrimaryOwner == false &&
            canManageUsers()
          )
        );
      allow update: if isValidId(userId) &&
        isValidPortalUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        incoming().isPrimaryOwner == existing().isPrimaryOwner &&
        (
          !existing().isPrimaryOwner ||
          (
            incoming().role == 'Admin' &&
            incoming().active == true &&
            incoming().permissions.usersManage == true &&
            incoming().permissions.inventoryRead == true &&
            incoming().permissions.inventoryWrite == true &&
            incoming().permissions.inventoryDelete == true &&
            incoming().permissions.bookingsRead == true &&
            incoming().permissions.bookingsWrite == true &&
            incoming().permissions.bookingsDelete == true &&
            incoming().permissions.videosManage == true
          )
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'role',
          'active',
          'permissions',
          'updatedAt'
        ]) &&
        canManageUsers();
      allow delete: if isValidId(userId) &&
        existing().isPrimaryOwner == false &&
        userId != requesterEmailKey() &&
        canManageUsers();
    }
  }
}
