{
  "entities": {
    "ExportVehicle": {
      "title": "ExportVehicle",
      "description": "Japanese export vehicle listing available for direct import booking or port balance-release.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "makeModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "trim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["SUVs & 4x4", "Hybrids", "Sedans", "Commercial"]
        },
        "status": {
          "type": "string",
          "enum": ["Available", "Booked", "In Transit", "Cleared"]
        },
        "year": {
          "type": "integer"
        },
        "mileageKm": {
          "type": "number"
        },
        "chassisCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "transmission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "drive": {
          "type": "string",
          "enum": ["4WD", "2WD", "AWD"]
        },
        "fuel": {
          "type": "string",
          "enum": ["Hybrid", "Diesel", "Petrol"]
        },
        "steering": {
          "type": "string",
          "enum": ["RHD", "LHD"]
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fobUsd": {
          "type": "number"
        },
        "cbm": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000
        },
        "images": {
          "type": "array",
          "description": "Gallery image URLs or compressed JPEG data URLs (max 8 entries)."
        },
        "imageAlt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "transit": {
          "type": "object",
          "description": "Shipping, CIF pricing, and port balance tracking details."
        },
        "inspection": {
          "type": "object",
          "description": "Auction sheet and mechanical inspection metadata."
        }
      },
      "required": [
        "id",
        "makeModel",
        "trim",
        "category",
        "status",
        "year",
        "mileageKm",
        "chassisCode",
        "engine",
        "transmission",
        "drive",
        "fuel",
        "steering",
        "color",
        "port",
        "fobUsd",
        "image",
        "imageAlt",
        "createdAt",
        "transit",
        "inspection"
      ]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "Buyer vehicle booking inquiry or CRM lead record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "vehicleId": {
          "type": "string",
          "maxLength": 128
        },
        "vehicleTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chassisCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "buyerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "buyerPhone": {
          "type": "string",
          "maxLength": 48
        },
        "destinationPortId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "destinationPortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requestType": {
          "type": "string",
          "enum": [
            "Book Direct Japan Import",
            "Claim Port Balance Unit",
            "Custom Auction Order"
          ]
        },
        "shippingMethod": {
          "type": "string",
          "enum": ["RoRo Vessel", "20ft Container", "40ft Shared Container"]
        },
        "quotedAmountUsd": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "leadSource": {
          "type": "string",
          "maxLength": 120
        },
        "crmNotes": {
          "type": "string",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending Review",
            "Contacted",
            "Deposit Confirmed",
            "Shipped / B/L Issued",
            "Cancelled"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "vehicleTitle",
        "chassisCode",
        "buyerName",
        "buyerEmail",
        "buyerPhone",
        "destinationPortId",
        "destinationPortName",
        "requestType",
        "shippingMethod",
        "quotedAmountUsd",
        "notes",
        "status",
        "createdAt"
      ]
    },
    "UnloadingVideo": {
      "title": "UnloadingVideo",
      "description": "Container unloading showcase clip metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "portLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "containerType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "vehicleSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "videoUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000
        },
        "posterUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000
        },
        "durationLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "title",
        "portLabel",
        "containerType",
        "vehicleSummary",
        "videoUrl",
        "posterUrl",
        "durationLabel",
        "createdAt"
      ]
    },
    "PortalUser": {
      "title": "PortalUser",
      "description": "Authorized Seller Portal & CRM team member account with role and module permissions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["Admin", "Editor", "Viewer"]
        },
        "active": {
          "type": "boolean"
        },
        "permissions": {
          "type": "object",
          "description": "Granular read/write/delete flags for inventory, bookings, videos, and users."
        },
        "isPrimaryOwner": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "active",
        "permissions",
        "isPrimaryOwner",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": "ExportVehicle",
      "description": "Publicly readable vehicle inventory managed by authorized Seller Portal staff."
    },
    "/bookings/{bookingId}": {
      "schema": "BookingRequest",
      "description": "Buyer booking inquiries created from storefront and managed by authorized Seller Portal staff."
    },
    "/videos/{videoId}": {
      "schema": "UnloadingVideo",
      "description": "Publicly readable container unloading clips managed by authorized Seller Portal staff."
    },
    "/portalUsers/{userId}": {
      "schema": "PortalUser",
      "description": "Authorized team accounts keyed deterministically by sanitized lowercase email for O(1) RBAC checks."
    }
  }
}
